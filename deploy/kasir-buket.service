# /etc/systemd/system/kasir-buket.service
[Unit]
Description=Kasir Buket - server sinkron
After=network.target

[Service]
Type=simple
User=kasir
WorkingDirectory=/opt/kasir-buket/server
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/opt/kasir-buket/data
Environment=STATIC_DIR=/opt/kasir-buket/app/dist
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
